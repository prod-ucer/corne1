#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        Lshift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <16 38>;
            layers = <0 6>;
        };

        Rshift {
            bindings = <&kp RIGHT_SHIFT>;
            key-positions = <39 19>;
            layers = <0 6>;
        };

        Lctrl {
            bindings = <&kp LCTRL>;
            key-positions = <38 15>;
            layers = <0 6>;
        };

        Rctrl {
            bindings = <&kp RCTRL>;
            key-positions = <39 20>;
            layers = <0 6>;
        };

        Lalt {
            bindings = <&kp LEFT_ALT>;
            key-positions = <38 14>;
            layers = <0 6>;
        };

        Ralt {
            bindings = <&kp RIGHT_ALT>;
            key-positions = <39 21>;
            layers = <0 6>;
        };

        left_num_layer {
            bindings = <&mo 1>;
            key-positions = <38 24>;
            slow-release;
        };

        left_arrow_layer {
            bindings = <&mo 2>;
            key-positions = <38 12>;
            slow-release;
        };

        test3 {
            bindings = <&mo 6>;
            key-positions = <38>;
            layers = <5>;
        };
    };

    behaviors {
        td_kp1_f1: TD_1 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_1";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_1>, <&kp F1>;
        };

        td_kp2_f2: TD_2 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_2";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_2>, <&kp F2>;
        };

        td_kp3_f3: TD_3 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_3";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_3>, <&kp F3>;
        };

        td_kp4_f4: TD_4 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_4";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_4>, <&kp F4>;
        };

        td_kp5_f5: TD_5 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_5";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_5>, <&kp F5>;
        };

        td_kp6_f6: TD_6 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_6";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_6>, <&kp F6>;
        };

        td_kp7_f7: TD_7 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_7";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_7>, <&kp F7>;
        };

        td_kp8_f8: TD_8 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_8";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_8>, <&kp F8>;
        };

        td_kp9_f9: TD_9 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_9";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_9>, <&kp F9>;
        };

        td_kp0_f0: TD_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_0";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_0>, <&kp F10>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB    &kp Q  &kp W  &kp E     &kp R      &kp T    &kp Y  &kp U      &kp I      &kp O    &kp P     &kp SQT
&kp LCTRL  &kp A  &kp S  &kp D     &kp F      &kp G    &kp H  &kp J      &kp K      &kp L    &kp SEMI  &kp BACKSPACE
&kp LSHFT  &kp Z  &kp X  &kp C     &kp V      &kp B    &kp N  &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                         &kp LGUI  &kp SPACE  &mo 3    &mo 4  &kp ENTER  &trans
            >;
        };

        left_num_and_ultilities {
            bindings = <
&kp ESCAPE  &kp GRAVE  &td_kp7_f7  &td_kp8_f8  &td_kp9_f9  &kp LBKT      &trans  &trans  &trans  &trans  &trans  &trans
&kp M       &kp EQUAL  &td_kp4_f4  &td_kp5_f5  &td_kp6_f6  &kp RBKT      &trans  &trans  &trans  &trans  &trans  &trans
&to 0       &kp MINUS  &td_kp1_f1  &td_kp2_f2  &td_kp3_f3  &td_kp0_f0    &trans  &trans  &trans  &trans  &trans  &trans
                                   &tog 7      &trans      &trans        &trans  &trans  &trans
            >;
        };

        left_arrow {
            bindings = <
&trans  &trans  &trans    &kp UP    &trans     &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans    &trans    &trans     &trans    &trans  &trans  &trans  &trans  &trans  &trans
                          &trans    &trans     &trans    &trans  &trans  &trans
            >;
        };

        lower_layer {
            bindings = <
&tog 0  &kp LC(LS(TAB))  &kp LC(TAB)  &kp TAB    &kp ESC    &kp DEL      &kp GRAVE  &td_kp7_f7  &td_kp8_f8  &td_kp9_f9  &kp LBKT  &trans
&tog 7  &kp CAPS         &kp LALT     &kp LCTRL  &kp LSHFT  &kp ENTER    &kp EQUAL  &td_kp4_f4  &td_kp5_f5  &td_kp6_f6  &kp RBKT  &trans
&tog 5  &kp F11          &kp F12      &kp LC(C)  &kp LC(V)  &kp LGUI     &kp MINUS  &td_kp1_f1  &td_kp2_f2  &td_kp3_f3  &kp BSLH  &trans
                                      &trans     &trans     &trans       &trans     &trans      &td_kp0_f0
            >;

            label = "Lower Layer";
        };

        raise_layer {
            display-name = "Raise Layer";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &trans  &trans          &mmv MOVE_UP    &trans           &trans    &trans    &mkp MB1  &mkp MB2  &trans     &trans     &trans
&trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans    &kp HOME  &kp END   &kp UP    &kp PG_UP  &kp PG_DN  &trans
&trans  &trans  &trans          &trans          &trans           &trans    &trans    &kp LEFT  &kp DOWN  &kp RIGHT  &trans     &trans
                                &trans          &trans           &trans    &trans    &trans    &trans
            >;
        };

        game_lol_default {
            display-name = "Game LoL default";
            bindings = <
&kp TAB     &kp Q  &kp W  &kp E   &kp R      &kp T    &kp Y  &kp U      &kp I      &kp O    &kp P     &kp SQT
&kp LCTRL   &kp A  &kp S  &kp D   &kp F      &kp G    &kp H  &kp J      &kp K      &kp L    &kp SEMI  &kp BACKSPACE
&kp ESCAPE  &kp Z  &kp X  &kp C   &kp V      &kp B    &kp N  &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                          &tog 5  &kp SPACE  &mo 6    &mo 4  &kp ENTER  &trans
            >;
        };

        game_lol_lower {
            display-name = "Game LoL lower";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB  &kp N1  &kp N2  &kp N3  &kp LS(N4)  &kp P            &trans  &trans  &trans  &trans  &trans  &trans
&trans   &kp N5  &kp N6  &kp N7  &trans      &trans           &trans  &trans  &trans  &trans  &trans  &trans
&to 0    &trans  &trans  &trans  &trans      &kp LS(ENTER)    &trans  &trans  &trans  &trans  &trans  &trans
                         &tog 5  &trans      &trans           &trans  &trans  &trans
            >;
        };

        game_wasd_default {
            display-name = "Game WASD default";
            bindings = <
&kp TAB    &kp Q  &kp E  &kp W   &kp R      &kp T    &kp Y  &kp U      &kp I      &kp O    &kp P     &kp SQT
&kp LSHFT  &kp F  &kp A  &kp S   &kp D      &kp G    &kp H  &kp J      &kp K      &kp L    &kp SEMI  &kp BACKSPACE
&kp LCTRL  &kp Z  &kp X  &kp C   &kp V      &kp B    &kp N  &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                         &tog 7  &kp SPACE  &mo 1    &mo 4  &kp ENTER  &trans
            >;
        };

        navigation_layer {
            bindings = <
&trans  &kp LG(N1)  &kp LG(N2)  &kp LG(N3)  &kp LG(N4)  &kp LG(N5)    &kp LG(N6)  &kp LG(N7)  &kp LG(N8)  &kp LG(N9)  &kp LG(N0)  &trans
&trans  &trans      &trans      &trans      &trans      &trans        &trans      &trans      &trans      &trans      &trans      &kp LC(LG(LEFT))
&trans  &trans      &trans      &trans      &trans      &trans        &trans      &trans      &trans      &trans      &trans      &kp LC(LG(RIGHT))
                                &trans      &trans      &trans        &trans      &trans      &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        layer3 {
            if-layers = <7 4>;
            then-layer = <9>;
        };
    };
};
